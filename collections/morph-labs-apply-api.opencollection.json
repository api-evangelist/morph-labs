{
  "opencollection": "1.0.0",
  "info": {
    "name": "Morph Apply API",
    "version": "3.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Apply",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Apply a code edit (Fast Apply)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.morphllm.com/v1/chat/completions",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "OpenAI-compatible chat completions used as the Apply endpoint. Send a single user message whose content contains XML-tagged <instruction>, <code>, and <update> sections. The model merges the update into the original code and returns the fully merged file as the assistant message content."
        }
      ]
    }
  ],
  "bundled": true
}